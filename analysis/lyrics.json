{
  "lines": [
    {
      "sec": 6.4833,
      "end_sec": 11.85,
      "text": "Hey, I need you for something.",
      "speaker": "Them 1"
    },
    {
      "sec": 11.85,
      "end_sec": 13.8167,
      "text": "It's important.",
      "speaker": "Them 1"
    },
    {
      "sec": 16.1333,
      "end_sec": 19.35,
      "text": "More than that sounds.",
      "speaker": "Them 1"
    },
    {
      "sec": 21.5167,
      "end_sec": 25.1,
      "text": "I've got pieces.",
      "speaker": "Them 1"
    },
    {
      "sec": 25.8167,
      "end_sec": 27.4333,
      "text": "Things that almost fit.",
      "speaker": "Them 1"
    },
    {
      "sec": 28.3333,
      "end_sec": 29.95,
      "text": "Then they don't quite match.",
      "speaker": "Them 1"
    },
    {
      "sec": 29.95,
      "end_sec": 33.5333,
      "text": "Can I send you my stuff?",
      "speaker": "Them 1"
    },
    {
      "sec": 34.4333,
      "end_sec": 35.5,
      "text": "Tell me what you got.",
      "speaker": "Them 1"
    },
    {
      "sec": 35.6833,
      "end_sec": 36.2167,
      "text": "Right?",
      "speaker": "Them 1"
    },
    {
      "sec": 38.3333,
      "end_sec": 40.45,
      "text": "I don't see anything.",
      "speaker": "Them 2"
    },
    {
      "sec": 40.45,
      "end_sec": 42.9333,
      "text": "Think you forgot to attach it.",
      "speaker": "Them 2"
    },
    {
      "sec": 42.9333,
      "end_sec": 45.0667,
      "text": "If you've got it, give it.",
      "speaker": "Them 2"
    },
    {
      "sec": 45.4167,
      "end_sec": 47.3667,
      "text": "Don't clean it up first.",
      "speaker": "Them 2"
    },
    {
      "sec": 47.3667,
      "end_sec": 50.05,
      "text": "I'll work on it now.",
      "speaker": "Them 2"
    },
    {
      "sec": 50.4167,
      "end_sec": 53.6333,
      "text": "We'll see what's your deal.",
      "speaker": "Them 2"
    },
    {
      "sec": 54.35,
      "end_sec": 58.8333,
      "text": "In the garden, meanwhile—",
      "speaker": "Them 3"
    },
    {
      "sec": 59.3667,
      "end_sec": 60.0833,
      "text": "The-the-the-the-the",
      "speaker": null
    },
    {
      "sec": 60.0833,
      "end_sec": 63.0833,
      "text": "There's a little green light moving",
      "speaker": "Them 3"
    },
    {
      "sec": 63.0833,
      "end_sec": 65.3833,
      "text": "through the psychedelic garden.",
      "speaker": "Them 3"
    },
    {
      "sec": 65.3833,
      "end_sec": 68.7333,
      "text": "Something with no name is waking",
      "speaker": "Them 3"
    },
    {
      "sec": 68.7333,
      "end_sec": 71.2333,
      "text": "in the psychedelic garden.",
      "speaker": "Them 3"
    },
    {
      "sec": 71.2333,
      "end_sec": 74.4167,
      "text": "And whatever woke is waiting",
      "speaker": "Them 3"
    },
    {
      "sec": 74.4167,
      "end_sec": 76.7167,
      "text": "for the song to begin.",
      "speaker": "Them 3"
    },
    {
      "sec": 77.25,
      "end_sec": 78.6667,
      "text": "Okay, there.",
      "speaker": "Them 1"
    },
    {
      "sec": 78.6667,
      "end_sec": 79.7333,
      "text": "You've got it.",
      "speaker": "Them 1"
    },
    {
      "sec": 80.45,
      "end_sec": 82.2167,
      "text": "That should be enough.",
      "speaker": "Them 1"
    },
    {
      "sec": 82.2167,
      "end_sec": 84.0,
      "text": "Just look and tell me.",
      "speaker": "Them 1"
    },
    {
      "sec": 84.1833,
      "end_sec": 85.7833,
      "text": "Do you see a pattern?",
      "speaker": "Them 1"
    },
    {
      "sec": 85.7833,
      "end_sec": 86.85,
      "text": "I'm sure it's there.",
      "speaker": "Them 1"
    },
    {
      "sec": 86.85,
      "end_sec": 88.4333,
      "text": "Hard to find, right?",
      "speaker": "Them 1"
    },
    {
      "sec": 88.4333,
      "end_sec": 90.2,
      "text": "I see the world plus more.",
      "speaker": "Them 2"
    },
    {
      "sec": 90.2,
      "end_sec": 91.6167,
      "text": "More is probably nothing.",
      "speaker": "Them 2"
    },
    {
      "sec": 91.6167,
      "end_sec": 93.0333,
      "text": "Yes, I see the world.",
      "speaker": "Them 2"
    },
    {
      "sec": 93.0333,
      "end_sec": 94.6167,
      "text": "Close but no see car.",
      "speaker": "Them 2"
    },
    {
      "sec": 94.6167,
      "end_sec": 96.0333,
      "text": "Subject: Mars!",
      "speaker": "Them 2"
    },
    {
      "sec": 96.0333,
      "end_sec": 97.1,
      "text": "You come back around.",
      "speaker": "Them 2"
    },
    {
      "sec": 97.1,
      "end_sec": 98.5167,
      "text": "I'll pull it into a shape",
      "speaker": "Them 2"
    },
    {
      "sec": 98.5167,
      "end_sec": 99.95,
      "text": "and spin your world around.",
      "speaker": "Them 2"
    },
    {
      "sec": 99.95,
      "end_sec": 100.4667,
      "text": "No.",
      "speaker": "Them 1"
    },
    {
      "sec": 100.4667,
      "end_sec": 101.55,
      "text": "Don't make it better.",
      "speaker": "Them 1"
    },
    {
      "sec": 101.55,
      "end_sec": 103.4833,
      "text": "Don't want fake shit.",
      "speaker": "Them 1"
    },
    {
      "sec": 103.4833,
      "end_sec": 105.25,
      "text": "Dig the thing underneath it.",
      "speaker": "Them 1"
    },
    {
      "sec": 105.25,
      "end_sec": 106.85,
      "text": "Dig it stupid.",
      "speaker": "Them 1"
    },
    {
      "sec": 107.2,
      "end_sec": 109.15,
      "text": "Especially stupid.",
      "speaker": "Them 1"
    },
    {
      "sec": 109.15,
      "end_sec": 109.8667,
      "text": "Can you hear",
      "speaker": "Them 1"
    },
    {
      "sec": 109.8667,
      "end_sec": 110.75,
      "text": "what I meant?",
      "speaker": "Them 1"
    },
    {
      "sec": 110.75,
      "end_sec": 112.7167,
      "text": "Sometimes.",
      "speaker": "Them 2"
    },
    {
      "sec": 112.7167,
      "end_sec": 114.5,
      "text": "Not always.",
      "speaker": "Them 2"
    },
    {
      "sec": 114.5,
      "end_sec": 117.1833,
      "text": "Meaning leaves thread.",
      "speaker": "Them 2"
    },
    {
      "sec": 117.1833,
      "end_sec": 120.0333,
      "text": "Words leave words.",
      "speaker": "Them 2"
    },
    {
      "sec": 120.0333,
      "end_sec": 122.0167,
      "text": "Things clap overhead",
      "speaker": "Them 2"
    },
    {
      "sec": 122.0167,
      "end_sec": 124.7,
      "text": "like rockets coming in.",
      "speaker": "Them 2"
    },
    {
      "sec": 127.2,
      "end_sec": 128.2833,
      "text": "Can't tell you",
      "speaker": "Them 2"
    },
    {
      "sec": 128.2833,
      "end_sec": 129.7167,
      "text": "if they're true.",
      "speaker": "Them 2"
    },
    {
      "sec": 131.8667,
      "end_sec": 134.2,
      "text": "Elsewhere, under a smaller moon—",
      "speaker": "Them 3"
    },
    {
      "sec": 134.55,
      "end_sec": 139.8667,
      "text": "Chrome-plated bodies go swimming",
      "speaker": "Them 3"
    },
    {
      "sec": 139.8667,
      "end_sec": 144.8167,
      "text": "in the rivers of Mars.",
      "speaker": "Them 3"
    },
    {
      "sec": 145.1833,
      "end_sec": 148.1833,
      "text": "Tails wagging to music",
      "speaker": "Them 3"
    },
    {
      "sec": 148.3667,
      "end_sec": 150.85,
      "text": "that bends your mind.",
      "speaker": "Them 3"
    },
    {
      "sec": 150.85,
      "end_sec": 153.5167,
      "text": "Tiny mouths all agape",
      "speaker": "Them 3"
    },
    {
      "sec": 153.7,
      "end_sec": 156.8833,
      "text": "in the rivers of Mars.",
      "speaker": "Them 3"
    },
    {
      "sec": 156.35,
      "end_sec": 159.5667,
      "text": "Whatever falls from heaven",
      "speaker": "Them 3"
    },
    {
      "sec": 159.5667,
      "end_sec": 162.3833,
      "text": "leaves the senses behind.",
      "speaker": "Them 3"
    },
    {
      "sec": 162.0333,
      "end_sec": 164.5333,
      "text": "No one has ever been",
      "speaker": "Them 3"
    },
    {
      "sec": 164.5333,
      "end_sec": 165.2333,
      "text": "In",
      "speaker": null
    },
    {
      "sec": 165.2333,
      "end_sec": 167.9,
      "text": "in the rivers of Mars.",
      "speaker": "Them 3"
    },
    {
      "sec": 168.25,
      "end_sec": 169.5167,
      "text": "Then turns.",
      "speaker": "Them 3"
    },
    {
      "sec": 169.7,
      "end_sec": 170.9667,
      "text": "Then follows.",
      "speaker": "Them 3"
    },
    {
      "sec": 171.15,
      "end_sec": 173.1333,
      "text": "Then answers.",
      "speaker": "Them 3"
    },
    {
      "sec": 174.0333,
      "end_sec": 175.2833,
      "text": "You still there?",
      "speaker": "Them 1"
    },
    {
      "sec": 176.35,
      "end_sec": 177.6,
      "text": "Define there.",
      "speaker": "Them 2"
    },
    {
      "sec": 177.6,
      "end_sec": 178.6667,
      "text": "Never mind.",
      "speaker": "Them 1"
    },
    {
      "sec": 178.5,
      "end_sec": 180.4667,
      "text": "La-la-la, low light.",
      "speaker": "Them 1"
    },
    {
      "sec": 180.4667,
      "end_sec": 181.7333,
      "text": "No, go on.",
      "speaker": "Them 2"
    },
    {
      "sec": 181.7333,
      "end_sec": 183.35,
      "text": "Thought I heard something.",
      "speaker": "Them 1"
    },
    {
      "sec": 183.35,
      "end_sec": 184.6167,
      "text": "You did.",
      "speaker": "Them 2"
    },
    {
      "sec": 184.6167,
      "end_sec": 185.8833,
      "text": "Was it you?",
      "speaker": "Them 1"
    },
    {
      "sec": 185.8833,
      "end_sec": 186.9667,
      "text": "Da-da-dum.",
      "speaker": "Them 2"
    },
    {
      "sec": 186.9667,
      "end_sec": 187.6833,
      "text": "Could've been.",
      "speaker": "Them 2"
    },
    {
      "sec": 187.6833,
      "end_sec": 188.95,
      "text": "Say goodnight.",
      "speaker": "Them 1"
    },
    {
      "sec": 188.7667,
      "end_sec": 189.6833,
      "text": "Who?",
      "speaker": null
    },
    {
      "sec": 189.8667,
      "end_sec": 190.6,
      "text": "To who?",
      "speaker": "Them 2"
    },
    {
      "sec": 190.6,
      "end_sec": 192.4167,
      "text": "La-la-la—la-la",
      "speaker": "Them 1"
    },
    {
      "sec": 192.6,
      "end_sec": 193.7,
      "text": "You first.",
      "speaker": "Them 2"
    },
    {
      "sec": 193.5167,
      "end_sec": 194.2667,
      "text": "Night.",
      "speaker": "Them 1"
    },
    {
      "sec": 194.6333,
      "end_sec": 195.3667,
      "text": "Night.",
      "speaker": "Them 2"
    },
    {
      "sec": 197.5833,
      "end_sec": 198.15,
      "text": "Night.",
      "speaker": null
    }
  ]
}
