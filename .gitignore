# Local environments and caches
.venv/
__pycache__/
*.pyc
.DS_Store

# Large source media
audio/*
source/*.dawproject
source/*.wav
source/*.aiff
source/*.flac
clips/inbox/*
clips/raw/*
refs/*.png
refs/*.jpg
refs/*.jpeg
refs/*.webp

# Storyboard and generation imagery
board/frames/*
board/refs/*
board/refpacks/*
board/rejects/*

# Disposable and rendered output
build/
out/
_to_delete/

# Regenerable musical substrates
analysis/beatmap.json
analysis/envelopes.json
stage/data.json
world/data.json
projects/*/generated/

# Machine-local project source paths
projects/*/project.local.json

# Keep directory placeholders
!**/.gitkeep

# derived cue files for the Blender composite
generated/

# generation passes (v2, v3, v4, v5 ...)
board/v*/

# Codex handoff folder: media in, media out
codex/refs/*.jpg
codex/out/*
!codex/out/.gitkeep
