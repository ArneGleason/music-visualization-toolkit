{
  "schemaVersion": 1,
  "project": "rivers-of-mars",
  "updatedBy": "human+ai",
  "tracks": [
    {
      "id": "lyrics",
      "type": "lyrics",
      "label": "Lyrics",
      "color": "#f6c85f",
      "items": [
        {
          "id": "lyr-001",
          "section": "section-1",
          "speaker": "Them 1",
          "text": "Hey, I need you for something.",
          "timingStatus": "placed",
          "start": "5.1",
          "end": "6.4.480",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-002",
          "section": "section-1",
          "speaker": "Them 1",
          "text": "It's important.",
          "timingStatus": "placed",
          "start": "6.4.480",
          "end": "7.3.240"
        },
        {
          "id": "lyr-003",
          "section": "section-1",
          "speaker": "Them 1",
          "text": "More than that sounds.",
          "timingStatus": "placed",
          "start": "8.2.480",
          "end": "9.3",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-004",
          "section": "section-1",
          "speaker": "Them 1",
          "text": "I've got pieces.",
          "timingStatus": "placed",
          "start": "10.2",
          "end": "11.3"
        },
        {
          "id": "lyr-005",
          "section": "section-1",
          "speaker": "Them 1",
          "text": "Things that almost fit.",
          "timingStatus": "placed",
          "start": "11.4",
          "end": "12.2.240",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-006",
          "section": "section-1",
          "speaker": "Them 1",
          "text": "Then they don't quite match.",
          "timingStatus": "placed",
          "start": "12.3.480",
          "end": "13.1.720"
        },
        {
          "id": "lyr-007",
          "section": "section-1",
          "speaker": "Them 1",
          "text": "Can I send you my stuff?",
          "timingStatus": "placed",
          "start": "13.1.720",
          "end": "14.2.720"
        },
        {
          "id": "lyr-008",
          "section": "section-1",
          "speaker": "Them 1",
          "text": "Tell me what you got.",
          "timingStatus": "placed",
          "start": "14.4",
          "end": "15.1.480",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-009",
          "section": "section-1",
          "speaker": "Them 1",
          "text": "Right?",
          "timingStatus": "placed",
          "start": "15.1.720",
          "end": "15.2.480"
        },
        {
          "id": "lyr-010",
          "section": "section-2",
          "speaker": "Them 2",
          "text": "I don't see anything.",
          "timingStatus": "placed",
          "start": "16.1.480",
          "end": "16.4.480"
        },
        {
          "id": "lyr-011",
          "section": "section-2",
          "speaker": "Them 2",
          "text": "Think you forgot to attach it.",
          "timingStatus": "placed",
          "start": "16.4.480",
          "end": "17.4"
        },
        {
          "id": "lyr-012",
          "section": "section-2",
          "speaker": "Them 2",
          "text": "If you've got it, give it.",
          "timingStatus": "placed",
          "start": "17.4",
          "end": "18.3"
        },
        {
          "id": "lyr-013",
          "section": "section-2",
          "speaker": "Them 2",
          "text": "Don't clean it up first.",
          "timingStatus": "placed",
          "start": "18.3.480",
          "end": "19.2.240"
        },
        {
          "id": "lyr-014",
          "section": "section-2",
          "speaker": "Them 2",
          "text": "I'll work on it now.",
          "timingStatus": "placed",
          "start": "19.2.240",
          "end": "20.2"
        },
        {
          "id": "lyr-015",
          "section": "section-2",
          "speaker": "Them 2",
          "text": "We'll see what's your deal.",
          "timingStatus": "placed",
          "start": "20.2.480",
          "end": "21.3",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-016",
          "section": "pre-chorus-1",
          "speaker": "Them 3",
          "text": "In the garden, meanwhile—",
          "timingStatus": "placed",
          "start": "21.4",
          "end": "23.2.240"
        },
        {
          "id": "lyr-017",
          "section": "chorus-1",
          "speaker": "Them 3",
          "text": "There's a little green light moving",
          "timingStatus": "placed",
          "start": "23.4",
          "end": "24.4.240"
        },
        {
          "id": "lyr-018",
          "section": "chorus-1",
          "speaker": "Them 3",
          "text": "through the psychedelic garden.",
          "timingStatus": "placed",
          "start": "24.4.240",
          "end": "25.3.480"
        },
        {
          "id": "lyr-019",
          "section": "chorus-1",
          "speaker": "Them 3",
          "text": "Something with no name is waking",
          "timingStatus": "placed",
          "start": "25.3.480",
          "end": "26.4.240"
        },
        {
          "id": "lyr-020",
          "section": "chorus-1",
          "speaker": "Them 3",
          "text": "in the psychedelic garden.",
          "timingStatus": "placed",
          "start": "26.4.240",
          "end": "27.3.720"
        },
        {
          "id": "lyr-021",
          "section": "chorus-1",
          "speaker": "Them 3",
          "text": "And whatever woke is waiting",
          "timingStatus": "placed",
          "start": "27.3.720",
          "end": "28.4.240"
        },
        {
          "id": "lyr-022",
          "section": "chorus-1",
          "speaker": "Them 3",
          "text": "for the song to begin.",
          "timingStatus": "placed",
          "start": "28.4.240",
          "end": "29.3.480"
        },
        {
          "id": "lyr-023",
          "section": "section-3",
          "speaker": "Them 1",
          "text": "Okay, there.",
          "timingStatus": "placed",
          "start": "29.4.240",
          "end": "30.2.240"
        },
        {
          "id": "lyr-024",
          "section": "section-3",
          "speaker": "Them 1",
          "text": "You've got it.",
          "timingStatus": "placed",
          "start": "30.2.240",
          "end": "30.3.720"
        },
        {
          "id": "lyr-025",
          "section": "section-3",
          "speaker": "Them 1",
          "text": "That should be enough.",
          "timingStatus": "placed",
          "start": "30.4.720",
          "end": "31.3.240"
        },
        {
          "id": "lyr-026",
          "section": "section-3",
          "speaker": "Them 1",
          "text": "Just look and tell me.",
          "timingStatus": "placed",
          "start": "31.3.240",
          "end": "32.1.720"
        },
        {
          "id": "lyr-027",
          "section": "section-3",
          "speaker": "Them 1",
          "text": "Do you see a pattern?",
          "timingStatus": "placed",
          "start": "32.2",
          "end": "32.4.240"
        },
        {
          "id": "lyr-028",
          "section": "section-3",
          "speaker": "Them 1",
          "text": "I'm sure it's there.",
          "timingStatus": "placed",
          "start": "32.4.240",
          "end": "33.1.720"
        },
        {
          "id": "lyr-029",
          "section": "section-3",
          "speaker": "Them 1",
          "text": "Hard to find, right?",
          "timingStatus": "placed",
          "start": "33.1.720",
          "end": "33.4"
        },
        {
          "id": "lyr-030",
          "section": "section-4",
          "speaker": "Them 2",
          "text": "I see the world plus more.",
          "timingStatus": "placed",
          "start": "33.4",
          "end": "34.2.480"
        },
        {
          "id": "lyr-031",
          "section": "section-4",
          "speaker": "Them 2",
          "text": "More is probably nothing.",
          "timingStatus": "placed",
          "start": "34.2.480",
          "end": "34.4.480"
        },
        {
          "id": "lyr-032",
          "section": "section-4",
          "speaker": "Them 2",
          "text": "Yes, I see the world.",
          "timingStatus": "placed",
          "start": "34.4.480",
          "end": "35.2.480"
        },
        {
          "id": "lyr-033",
          "section": "section-4",
          "speaker": "Them 2",
          "text": "Close but no see car.",
          "timingStatus": "placed",
          "start": "35.2.480",
          "end": "35.4.720",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-034",
          "section": "section-4",
          "speaker": "Them 2",
          "text": "Subject: Mars!",
          "timingStatus": "placed",
          "start": "35.4.720",
          "end": "36.2.720"
        },
        {
          "id": "lyr-035",
          "section": "section-4",
          "speaker": "Them 2",
          "text": "You come back around.",
          "timingStatus": "placed",
          "start": "36.2.720",
          "end": "36.4.240"
        },
        {
          "id": "lyr-036",
          "section": "section-4",
          "speaker": "Them 2",
          "text": "I'll pull it into a shape",
          "timingStatus": "placed",
          "start": "36.4.240",
          "end": "37.2.240",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-037",
          "section": "section-4",
          "speaker": "Them 2",
          "text": "and spin your world around.",
          "timingStatus": "placed",
          "start": "37.2.240",
          "end": "37.4.240"
        },
        {
          "id": "lyr-038",
          "section": "section-5",
          "speaker": "Them 1",
          "text": "No.",
          "timingStatus": "placed",
          "start": "37.4.240",
          "end": "38.1"
        },
        {
          "id": "lyr-039",
          "section": "section-5",
          "speaker": "Them 1",
          "text": "Don't make it better.",
          "timingStatus": "placed",
          "start": "38.1",
          "end": "38.2.480"
        },
        {
          "id": "lyr-040",
          "section": "section-5",
          "speaker": "Them 1",
          "text": "Don't want fake shit.",
          "timingStatus": "placed",
          "start": "38.2.480",
          "end": "39.1.240"
        },
        {
          "id": "lyr-041",
          "section": "section-5",
          "speaker": "Them 1",
          "text": "Dig the thing underneath it.",
          "timingStatus": "placed",
          "start": "39.1.240",
          "end": "39.3.720"
        },
        {
          "id": "lyr-042",
          "section": "section-5",
          "speaker": "Them 1",
          "text": "Dig it stupid.",
          "timingStatus": "placed",
          "start": "39.3.720",
          "end": "40.2"
        },
        {
          "id": "lyr-043",
          "section": "section-5",
          "speaker": "Them 1",
          "text": "Especially stupid.",
          "timingStatus": "placed",
          "start": "40.2.480",
          "end": "41.1.240"
        },
        {
          "id": "lyr-044",
          "section": "section-5",
          "speaker": "Them 1",
          "text": "Can you hear",
          "timingStatus": "placed",
          "start": "41.1.240",
          "end": "41.2.240"
        },
        {
          "id": "lyr-045",
          "section": "section-5",
          "speaker": "Them 1",
          "text": "what I meant?",
          "timingStatus": "placed",
          "start": "41.2.240",
          "end": "41.3.480"
        },
        {
          "id": "lyr-046",
          "section": "section-6",
          "speaker": "Them 2",
          "text": "Sometimes.",
          "timingStatus": "placed",
          "start": "41.3.480",
          "end": "42.2.240"
        },
        {
          "id": "lyr-047",
          "section": "section-6",
          "speaker": "Them 2",
          "text": "Not always.",
          "timingStatus": "placed",
          "start": "42.2.240",
          "end": "42.4.720"
        },
        {
          "id": "lyr-048",
          "section": "section-6",
          "speaker": "Them 2",
          "text": "Meaning leaves thread.",
          "timingStatus": "placed",
          "start": "42.4.720",
          "end": "43.4.480"
        },
        {
          "id": "lyr-049",
          "section": "section-6",
          "speaker": "Them 2",
          "text": "Words leave words.",
          "timingStatus": "placed",
          "start": "43.4.480",
          "end": "44.4.480"
        },
        {
          "id": "lyr-050",
          "section": "section-6",
          "speaker": "Them 2",
          "text": "Things clap overhead",
          "timingStatus": "placed",
          "start": "44.4.480",
          "end": "45.3.240",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-051",
          "section": "section-6",
          "speaker": "Them 2",
          "text": "like rockets coming in.",
          "timingStatus": "placed",
          "start": "45.3.240",
          "end": "46.3"
        },
        {
          "id": "lyr-052",
          "section": "section-6",
          "speaker": "Them 2",
          "text": "Can't tell you",
          "timingStatus": "placed",
          "start": "47.2.480",
          "end": "47.4"
        },
        {
          "id": "lyr-053",
          "section": "section-6",
          "speaker": "Them 2",
          "text": "if they're true.",
          "timingStatus": "placed",
          "start": "47.4",
          "end": "48.2"
        },
        {
          "id": "lyr-054",
          "section": "pre-chorus-2",
          "speaker": "Them 3",
          "text": "Elsewhere, under a smaller moon—",
          "timingStatus": "placed",
          "start": "49.1",
          "end": "49.4.240"
        },
        {
          "id": "lyr-055",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "Chrome-plated bodies go swimming",
          "timingStatus": "placed",
          "start": "49.4.720",
          "end": "51.4.240"
        },
        {
          "id": "lyr-056",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "in the rivers of Mars.",
          "timingStatus": "placed",
          "start": "51.4.240",
          "end": "53.3.240"
        },
        {
          "id": "lyr-057",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "Tails wagging to music",
          "timingStatus": "placed",
          "start": "53.3.720",
          "end": "54.4"
        },
        {
          "id": "lyr-058",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "that bends your mind.",
          "timingStatus": "placed",
          "start": "54.4.240",
          "end": "55.3.720"
        },
        {
          "id": "lyr-059",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "Tiny mouths all agape",
          "timingStatus": "placed",
          "start": "55.3.720",
          "end": "56.3.480"
        },
        {
          "id": "lyr-060",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "in the rivers of Mars.",
          "timingStatus": "placed",
          "start": "56.3.720",
          "end": "57.4.240"
        },
        {
          "id": "lyr-061",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "Whatever falls from heaven",
          "timingStatus": "placed",
          "start": "57.3.480",
          "end": "58.4"
        },
        {
          "id": "lyr-062",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "leaves the senses behind.",
          "timingStatus": "placed",
          "start": "58.4",
          "end": "59.4"
        },
        {
          "id": "lyr-063",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "No one has ever been",
          "timingStatus": "placed",
          "start": "59.3.480",
          "end": "60.3"
        },
        {
          "id": "lyr-064",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "in the rivers of Mars.",
          "timingStatus": "placed",
          "start": "60.4",
          "end": "61.3.720"
        },
        {
          "id": "lyr-065",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "Then turns.",
          "timingStatus": "placed",
          "start": "61.4.240",
          "end": "62.2"
        },
        {
          "id": "lyr-066",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "Then follows.",
          "timingStatus": "placed",
          "start": "62.2.240",
          "end": "62.4"
        },
        {
          "id": "lyr-067",
          "section": "chorus-2",
          "speaker": "Them 3",
          "text": "Then answers.",
          "timingStatus": "placed",
          "start": "62.4.240",
          "end": "63.3"
        },
        {
          "id": "lyr-068",
          "section": "outro",
          "speaker": "Them 1",
          "text": "You still there?",
          "timingStatus": "placed",
          "start": "63.4.240",
          "end": "64.2"
        },
        {
          "id": "lyr-069",
          "section": "outro",
          "speaker": "Them 2",
          "text": "Define there.",
          "timingStatus": "placed",
          "start": "64.3.480",
          "end": "65.1.240"
        },
        {
          "id": "lyr-070",
          "section": "outro",
          "speaker": "Them 1",
          "text": "Never mind.",
          "timingStatus": "placed",
          "start": "65.1.240",
          "end": "65.2.720"
        },
        {
          "id": "lyr-071",
          "section": "outro",
          "speaker": "Them 1",
          "text": "La-la-la, low light.",
          "timingStatus": "placed",
          "start": "65.2.480",
          "end": "66.1.240"
        },
        {
          "id": "lyr-072",
          "section": "outro",
          "speaker": "Them 2",
          "text": "No, go on.",
          "timingStatus": "placed",
          "start": "66.1.240",
          "end": "66.3"
        },
        {
          "id": "lyr-073",
          "section": "outro",
          "speaker": "Them 1",
          "text": "Thought I heard something.",
          "timingStatus": "placed",
          "start": "66.3",
          "end": "67.1.240"
        },
        {
          "id": "lyr-074",
          "section": "outro",
          "speaker": "Them 2",
          "text": "You did.",
          "timingStatus": "placed",
          "start": "67.1.240",
          "end": "67.3"
        },
        {
          "id": "lyr-075",
          "section": "outro",
          "speaker": "Them 1",
          "text": "Was it you?",
          "timingStatus": "placed",
          "start": "67.3",
          "end": "67.4.720"
        },
        {
          "id": "lyr-076",
          "section": "outro",
          "speaker": "Them 2",
          "text": "Da-da-dum.",
          "timingStatus": "placed",
          "start": "67.4.720",
          "end": "68.2.240"
        },
        {
          "id": "lyr-077",
          "section": "outro",
          "speaker": "Them 2",
          "text": "Could've been.",
          "timingStatus": "placed",
          "start": "68.2.240",
          "end": "68.3.240"
        },
        {
          "id": "lyr-078",
          "section": "outro",
          "speaker": "Them 1",
          "text": "Say goodnight.",
          "timingStatus": "placed",
          "start": "68.3.240",
          "end": "69.1"
        },
        {
          "id": "lyr-079",
          "section": "outro",
          "speaker": "Them 2",
          "text": "To who?",
          "timingStatus": "placed",
          "start": "69.2.240",
          "end": "69.3.240",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-080",
          "section": "outro",
          "speaker": "Them 1",
          "text": "La-la-la—la-la",
          "timingStatus": "placed",
          "start": "69.3.240",
          "end": "70.1.720"
        },
        {
          "id": "lyr-081",
          "section": "outro",
          "speaker": "Them 2",
          "text": "You first.",
          "timingStatus": "placed",
          "start": "70.2",
          "end": "70.3.480"
        },
        {
          "id": "lyr-082",
          "section": "outro",
          "speaker": "Them 1",
          "text": "Night.",
          "timingStatus": "placed",
          "start": "70.3.240",
          "end": "70.4.240",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": ""
          }
        },
        {
          "id": "lyr-083",
          "section": "outro",
          "speaker": "Them 2",
          "text": "Night.",
          "timingStatus": "placed",
          "start": "70.4.720",
          "end": "71.1.720",
          "drivers": [],
          "ai": {
            "status": "accepted",
            "note": "Night"
          }
        },
        {
